# Copy to .env and edit.

# Required. Bearer token for POST /webhook and POST /send.
WEBHOOK_TOKEN=

# Where Baileys stores WhatsApp Web credentials.
SESSION_DIR=./session

# HTTP API. Keep the host on 127.0.0.1 unless you have a protected reverse proxy.
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PORT=3091

# WhatsApp message chunk size. Baileys/WhatsApp accepts messages below this value.
WHATSAPP_MESSAGE_LIMIT=3900

# Optional HTTP(S) proxy for the WhatsApp WebSocket connection.
# PI_WHATSAPP_PROXY=http://127.0.0.1:7890

# Optional bidirectional mode: forward allowed incoming WhatsApp text to the
# Pi TUI extension's local HTTP listener.
WHATSAPP_INBOUND_URL=http://127.0.0.1:3092/whatsapp/inbound
INBOUND_WEBHOOK_TOKEN=
# Required for forwarding. Use comma-separated phone numbers, or * explicitly.
WHATSAPP_INBOUND_ALLOWED_SENDERS=
# bot ignores messages sent by the linked account; self-chat accepts your own
# messages but ignores replies sent by this service.
WHATSAPP_INBOUND_MODE=bot
